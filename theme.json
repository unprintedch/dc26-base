{
	"settings": {
		"appearanceTools": true,
		"blocks": {
			"core/site-title": {
				"typography": {
					"textDecoration": false,
					"fontFamily": true
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": true,
					"lineHeight": true,
					"fontWeight": true,
					"fontFamily": true
				},
				"spacing": {
					"padding": true,
					"margin": true
				}
			},
			"core/paragraph": {
				"typography": {
					"fontFamily": true
				}
			},
			"core/heading": {
				"typography": {
					"fontFamily": true
				}
			},
			"core/post-terms": {
				"styles": [
					{
						"name": "chips",
						"label": "Capsules"
					}
				]
			}
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": true,
			"defaultPalette": false,
			"gradients": [],
			"palette": [
				{
					"color": "#222222",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#000000",
					"name": "Primary hover",
					"slug": "primary-hover"
				},
				{
					"color": "#666666",
					"name": "Secondary",
					"slug": "secondary"
				},
				{
					"color": "#444444",
					"name": "Secondary hover",
					"slug": "secondary-hover"
				},
				{
					"color": "#000000",
					"name": "Black",
					"slug": "black"
				},
				{
					"color": "#ffffff",
					"name": "White",
					"slug": "white"
				}
			]
		},
		"layout": {
			"contentSize": "960px",
			"wideSize": "1360px",
			"allowEditing": true,
			"allowSwitching": true
		},
		"spacing": {
			"customSpacingSize": true,
			"spacingScale": {
				"theme": {
					"increment": 1.5,
					"mediumStep": 1.5,
					"operator": "*",
					"steps": 7,
					"unit": "rem"
				}
			},
			"spacingSizes": [
				{
					"name": "2x plus petit",
					"size": "0.44rem",
					"slug": "20"
				},
				{
					"name": "x plus petit",
					"size": "0.67rem",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "clamp(1rem, 3vw, 1.5rem)",
					"slug": "40"
				},
				{
					"name": "Medium",
					"size": "clamp(1.5rem, 4vw, 2rem)",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "clamp(2rem, 5vw, 3rem)",
					"slug": "60"
				},
				{
					"name": "Xlarge",
					"size": "clamp(3rem, 7vw, 4rem)",
					"slug": "70"
				},
				{
					"name": "2x plus grand",
					"size": "5.06rem",
					"slug": "80"
				}
			],
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		},
		"typography": {
			"fontFamily": true,
			"fontFamilies": [
				{
					"fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
					"name": "Body",
					"slug": "body"
				},
				{
					"fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
					"name": "Display",
					"slug": "display"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"name": "Large",
					"size": "1.25rem",
					"slug": "large"
				},
				{
					"name": "X Large",
					"size": "1.5rem",
					"slug": "x-large"
				},
				{
					"name": "XX Large",
					"size": "2rem",
					"slug": "xx-large"
				},
				{
					"name": "XXX Large",
					"size": "2.5rem",
					"slug": "xxx-large"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"spacing": {
			"margin": {
				"bottom": "0",
				"top": "0"
			},
			"padding": {
				"left": "var(--wp--preset--spacing--50)",
				"right": "var(--wp--preset--spacing--50)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)"
		}
	},
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page sans titre",
			"postTypes": [
				"page"
			]
		}
	],
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	],
	"version": 3,
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json"
}
